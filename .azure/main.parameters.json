    },
    "mysqlAdminPassword": {
      "reference": {
        "keyVault": {
          "id": ""
        },
        "secretName": "mysqlPassword"
      }
    },
    "mysqlDatabaseName": {
      "value": "taskmgrdb"
    }
  }
}
